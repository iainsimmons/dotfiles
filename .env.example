# Machine-local env for dotfiles-update (see ~/dotfiles/bin/dotfiles-update).
# Sourced and exported before any mise command runs, so bootstrap secrets
# (declared in [bootstrap.secrets]) resolve without prompting. Gitignored —
# never commit this file.
#
# Available vars (must match [bootstrap.secrets] keys):
#   GITLAB_INSTANCE  GitLab instance host used by the lazygit template
#   GIT_USER_EMAIL   user.email rendered into .gitconfig
#   LAZYGIT_OWNER    OS user that should own ~/.config/lazygit/config.yml
GIT_USER_EMAIL=email@example.com
LAZYGIT_OWNER=user
GITLAB_INSTANCE=gitlab.example.com
