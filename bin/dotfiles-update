#!/usr/bin/env bash
set -euo pipefail

# Update everything managed by this mise setup: the dotfiles repo (which
# describes the config), the shared [tools], the host [bootstrap.packages],
# the bootstrap task, and mise itself.
#
# Run from any interactive shell so MISE_ENV (desktop/macbook/…), the active
# shell and the package managers on PATH are inherited.

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

has() { command -v "$1" >/dev/null 2>&1; }

if has gum; then
  step() { gum style --foreground 12 --bold "$1"; }
  ok()   { gum style --foreground 10 "$1"; }
else
  step() { printf '\n== %s ==\n' "$1"; }
  ok()   { printf '%s\n' "$1"; }
fi

if ! has mise; then
  echo "mise is not installed — run: curl https://mise.run | sh" >&2
  exit 1
fi

cd "$DOTFILES_DIR"

# Load machine-local values (e.g. the bootstrap secrets): export everything
# from .env so the bare `mise bootstrap`/`mise run` calls below see them.
if [ -f "$DOTFILES_DIR/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  # shellcheck source=/dev/null
  . "$DOTFILES_DIR/.env"
  set +a
fi

step "Pulling the dotfiles repo"
git pull --ff-only

step "Applying dotfiles (mise dot apply --prompt-secrets)"
mise dot apply --prompt-secrets

step "Updating mise itself (mise self-update)"
if ! mise self-update -y; then
  echo "mise self-update failed — update it manually."
fi

step "Upgrading tools (mise upgrade)"
mise outdated || true
mise upgrade

step "Upgrading bootstrap packages (mise bootstrap packages upgrade)"
# Some AUR packages ship build trees with read-only dirs — hyprmoncfg's bundled
# Go module cache is 0555/0444 — and yay extracts the next version's sources
# over the previous build without clearing it, so every upgrade fails with a
# wall of "rm: cannot remove ...: Permission denied". Restore the write bits
# before pacman/yay get there. Linux only: that's where yay runs.
if [ "$(uname -s)" = "Linux" ] && has yay; then
  # Unmatched globs stay literal here; the guard swallows the resulting error.
  # shellcheck disable=SC2035
  chmod -R u+w "$HOME"/.cache/yay/*/src 2>/dev/null || true
fi
if [ -t 0 ]; then
  mise bootstrap packages upgrade
else
  echo "Skipping — needs sudo, which requires a TTY. Run it manually in a terminal."
fi

step "Re-running the bootstrap task (mise run bootstrap)"
mise run bootstrap

# nvpm is deliberately NOT synced here. `mise run bootstrap` above only syncs
# nvpm on a machine's first run (marker: ~/.config/nvpm/.bootstrapped), because
# `nvpm sync packages` costs ~80s and its extra-packages prompt is unanswerable
# non-interactively. `nvpm up` does prompt, so it is the interactive command.
# The second command captures nvpm's rewritten lock back into the repo, which
# only works because ~/.config/nvpm/* are per-file copy entries — `mise dot add
# --changed` skips directory copies.
if has nvpm; then
  step "nvpm packages"
  ok "Not synced automatically. To update plugins and save the result:"
  ok "  nvpm up --all"
  ok "  mise dot add --changed    # then commit .config/nvpm/ if it changed"
  ok "Always-failing here (not worth chasing): tree-sitter-markdown and"
  ok "tree-sitter-xml fail Neovim query validation; stylua can fail with"
  ok "'text file busy' while a stylua process holds the binary."
fi

ok "Done — everything managed by mise is up to date."
